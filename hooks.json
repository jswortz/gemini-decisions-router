{
  "gemini-decisions-router": {
    "PreInvocation": [
      {
        "command": "python3 ./router_hook.py pre-invocation",
        "timeout": 8
      }
    ],
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "command": "python3 ./router_hook.py pre-tool-use",
            "timeout": 6
          }
        ]
      }
    ]
  }
}
