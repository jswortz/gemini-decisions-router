# Gemini Decisions Router Environment Configuration Example
# Copy to .env (or export in your shell profile) and customize as needed.
# Never commit real API keys or OAuth tokens to source control.

# 1. Authentication Mode:
#    - "auto"       : Uses vertex_adc if GOOGLE_GENAI_USE_VERTEXAI=true,
#                     api_key if GEMINI_API_KEY is set, else gemini_adc (default).
#    - "gemini_adc" : Keyless ADC against generativelanguage.googleapis.com (recommended).
#    - "vertex_adc" : Keyless ADC against aiplatform.googleapis.com (requires Vertex preview enrollment).
#    - "api_key"    : Uses GEMINI_API_KEY against generativelanguage.googleapis.com.
GEMINI_DECISIONS_AUTH_MODE=gemini_adc

# 2. Google Cloud Project & Location (used by gemini_adc and vertex_adc)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Set to "true" only after your GCP project is enrolled in Vertex AI Decisions preview:
GOOGLE_GENAI_USE_VERTEXAI=false

# 3. Router Mode ("advisor", "auto_switch", or "off")
GEMINI_DECISIONS_ROUTER_MODE=advisor

# 4. Optional Sandbox API Key (leave unset when using ADC)
# GEMINI_API_KEY=
